# WAHA Plus Configuration
# Copy this to .env and customize

# Port
WAHA_PORT=3000

# Engine: NOWEB (lightweight/recommended), WEBJS (full browser), GOWS
WHATSAPP_DEFAULT_ENGINE=NOWEB

# Security - CHANGE THIS!
WAHA_API_KEY=your-super-secret-key-here

# Session limits (0 = unlimited)
WAHA_MAX_SESSIONS=0

# Auto-start sessions on boot (comma-separated)
# WHATSAPP_START_SESSION=account1,account2

# Dashboard
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=changeme

# Global Webhook (optional - applies to all sessions)
# WHATSAPP_HOOK_URL=https://your-server.com/webhook
# WHATSAPP_HOOK_EVENTS=message,session.status

# Logging: fatal, error, warn, info, debug, trace
WAHA_LOG_LEVEL=info
